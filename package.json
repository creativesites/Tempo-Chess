{
  "name": "tempo-chess",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm run dev --workspace=apps/web",
    "web:build": "npm run build --workspace=apps/web",
    "web:typecheck": "npm run lint --workspace=apps/web",
    "mobile:start": "npm run start --workspace=apps/mobile",
    "typecheck": "npm run web:typecheck && npm run --workspace=apps/mobile typecheck"
  }
}
